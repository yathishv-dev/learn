NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Vercel deployments can use Vercel OIDC instead of this key.
AI_GATEWAY_API_KEY=
# Pick an available tool-capable text model from the AI Gateway model catalog.
AI_MODEL=google/gemini-3.8-flash
# Optional server speech fallback when the device has no matching voice.
AI_SPEECH_MODEL=google/gemini-3.8-flash-lite-tts
